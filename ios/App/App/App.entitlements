<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Groups — shared container with the Share Extension.
	     The app writes the Supabase access token here; the extension reads it and
	     queues the shares it couldn't post. Both targets MUST declare the same id. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.forkmap.app</string>
	</array>
</dict>
</plist>
