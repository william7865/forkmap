<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same App Group as the App target — without it the extension can't read the
	     auth token nor hand its offline queue back to the app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.forkmap.app</string>
	</array>
</dict>
</plist>
